{
  "name": "@ai-task-escrow/indexer",
  "version": "1.0.0",
  "description": "Production-ready event indexer for AI Task Escrow Router on MultiversX",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "migrate": "ts-node src/migrations/run.ts",
    "seed": "ts-node src/migrations/seed.ts"
  },
  "keywords": [
    "multiversx",
    "blockchain",
    "indexer",
    "events",
    "postgresql",
    "redis",
    "typescript"
  ],
  "author": "AI Task Escrow Router",
  "license": "MIT",
  "dependencies": {
    "@multiversx/sdk-core": "^15.0.0",
    "@multiversx/sdk-network-providers": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "winston": "^3.10.0",
    "ws": "^8.14.0",
    "openapi-types": "^12.1.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "prom-client": "^14.2.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "npm:null@^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/ws": "^8.5.0",
    "@types/swagger-ui-express": "^5.0.0",
    "@types/yamljs": "^0.2.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
